    { "id": "human-note", "type": "text", "x": 40, "y": 740, "width": 1660, "height": 100, "text": "Solid = diagnostic path. Dashed = separate configuration and verification.\nA mock handover reference is NOT a live transfer. Customer lookup is NOT authentication.", "fontSize": 20, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "id": "footer", "type": "text", "x": 40, "y": 860, "width": 1660, "height": 90, "text": "Optional instructor demo after Stage 14 | CCI preview | Synthetic data only\nCCI is separate from the workshop's custom AG-UI contact centre. Voice, approvals, insights, and transfers need their own checks.", "fontSize": 16, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" }
