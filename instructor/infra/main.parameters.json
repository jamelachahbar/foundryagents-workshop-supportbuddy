{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "searchLocation": { "value": "${AZURE_SEARCH_LOCATION=}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "principalType": { "value": "${AZURE_PRINCIPAL_TYPE=User}" },
    "participantsGroupId": { "value": "${PARTICIPANTS_GROUP_ID=}" },
    "chatModelName": { "value": "${CHAT_MODEL_NAME=model-router}" },
    "chatModelVersion": { "value": "${CHAT_MODEL_VERSION=2025-11-18}" },
    "chatModelDeploymentName": { "value": "${CHAT_MODEL_DEPLOYMENT_NAME=model-router}" },
    "chatModelSku": { "value": "${CHAT_MODEL_SKU=GlobalStandard}" },
    "chatModelRoutingMode": { "value": "${CHAT_MODEL_ROUTING_MODE=balanced}" },
    "chatModelCapacity": { "value": "${CHAT_MODEL_CAPACITY=100}" },
    "deployEvaluationModel": { "value": "${DEPLOY_EVALUATION_MODEL=true}" },
    "evaluationModelName": { "value": "${EVALUATION_MODEL_NAME=gpt-5-mini}" },
    "evaluationModelVersion": { "value": "${EVALUATION_MODEL_VERSION=2025-08-07}" },
    "evaluationModelDeploymentName": { "value": "${EVALUATION_MODEL_DEPLOYMENT_NAME=supportbuddy-judge}" },
    "evaluationModelSku": { "value": "${EVALUATION_MODEL_SKU=GlobalStandard}" },
    "evaluationModelCapacity": { "value": "${EVALUATION_MODEL_CAPACITY=10}" },
    "resourceTags": { "value": "${AZURE_RESOURCE_TAGS=}" },
    "externalNetworkMcpUrl": { "value": "${EXTERNAL_NETWORK_MCP_URL=}" },
    "networkMcpExists": { "value": "${SERVICE_NETWORK_MCP_RESOURCE_EXISTS=false}" }
  }
}
