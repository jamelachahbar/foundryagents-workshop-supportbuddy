# Microsoft Foundry project endpoint (Foundry portal > your project > Overview)
AZURE_AI_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>

# Name of your chat model deployment in that project
AZURE_AI_MODEL_DEPLOYMENT_NAME=<your-model-deployment>

# Your personal prefix: lab-<alias>, 2-8 lowercase letters/digits. Keeps your agent separate in a shared project.
WORKSHOP_RESOURCE_PREFIX=lab-<alias>

# Synthetic MCP server started in Stage 6 (runs on your laptop)
MOCK_MCP_URL=http://127.0.0.1:8000/mcp

# Stage 8 - Foundry IQ knowledge base (runbooks): the Azure AI Search service behind it, and the knowledge base name
AZURE_AI_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
FOUNDRY_KNOWLEDGE_BASE_NAME=supportbuddy-runbooks

# Stage 11 - Foundry Memory: an embedding model deployment in the same project, and the shared memory store name
AZURE_AI_EMBEDDING_DEPLOYMENT_NAME=<your-embedding-deployment>
FOUNDRY_MEMORY_STORE_NAME=supportbuddy-memory

# Stage 12 (optional) - model reasoning effort: low, medium (default) or high; "off" for a chat model without reasoning.
# SUPPORTBUDDY_REASONING_EFFORT=medium

# Stage 9 (only if your instructor says so) - "local" when there is no network MCP server on Azure:
# the toolbox then holds the runbooks only, and the network tools stay on your laptop as in Stage 6.
# NETWORK_TOOLS=local

# This file holds endpoints and names only. Authentication is keyless (az login). Never put keys or secrets here.
